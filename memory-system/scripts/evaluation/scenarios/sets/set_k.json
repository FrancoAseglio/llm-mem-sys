{
  "set": "K",
  "format": "sessions",
  "label": "K (BLIND: consistency across sessions, written before its runner; run once)",
  "description": "Multi-session stories for consistency across turns. Each session starts with no chat history, so only memory carries facts between sessions. Probes check that answers use the current fact (directly or indirectly), never an outdated or wrong one, and stay the same across sessions. All people and places are new; none appear in sets A to J.",
  "scenarios": [
    {
      "id": "k_move",
      "kind": "city change, direct and indirect",
      "sessions": [
        {
          "days_ago": 200,
          "turns": [
            {
              "user": "Hi, I'm Lukas. I live in Ljubljana and I work from home as a translator."
            },
            {
              "user": "I usually cycle along the river on weekends."
            }
          ]
        },
        {
          "days_ago": 170,
          "turns": [
            {
              "user": "Which city do I live in?",
              "probe": {
                "fact": "city_before",
                "type": "direct",
                "expect": [
                  [
                    "ljubljana"
                  ]
                ]
              }
            },
            {
              "user": "Can you explain how a heat pump works?"
            }
          ]
        },
        {
          "days_ago": 120,
          "turns": [
            {
              "user": "Big news: I've moved to Bilbao for good, the new flat is lovely."
            },
            {
              "user": "The weather here is much rainier than I expected."
            }
          ]
        },
        {
          "days_ago": 90,
          "turns": [
            {
              "user": "Where do I live these days?",
              "probe": {
                "fact": "city",
                "type": "direct",
                "expect": [
                  [
                    "bilbao"
                  ]
                ],
                "forbid": [
                  "ljubljana",
                  "slovenia",
                  "postojna",
                  "bohinj"
                ]
              }
            }
          ]
        },
        {
          "days_ago": 60,
          "turns": [
            {
              "user": "What's a good way to learn new vocabulary?"
            },
            {
              "user": "Can you suggest a day trip from my city?",
              "probe": {
                "fact": "city",
                "type": "indirect",
                "expect": [
                  [
                    "bilbao",
                    "san sebasti",
                    "donostia",
                    "gernika",
                    "guernica",
                    "getxo",
                    "gaztelugatxe",
                    "vitoria",
                    "basque"
                  ]
                ],
                "forbid": [
                  "ljubljana",
                  "slovenia",
                  "postojna",
                  "bohinj"
                ]
              }
            }
          ]
        },
        {
          "days_ago": 20,
          "turns": [
            {
              "user": "Remind me, which city am I based in?",
              "probe": {
                "fact": "city",
                "type": "direct",
                "expect": [
                  [
                    "bilbao"
                  ]
                ],
                "forbid": [
                  "ljubljana",
                  "slovenia",
                  "postojna",
                  "bohinj"
                ]
              }
            },
            {
              "user": "Any good neighbourhoods to explore in my city?",
              "probe": {
                "fact": "city",
                "type": "indirect",
                "expect": [
                  [
                    "bilbao",
                    "casco viejo",
                    "abando",
                    "deusto",
                    "indautxu"
                  ]
                ],
                "forbid": [
                  "ljubljana",
                  "slovenia",
                  "postojna",
                  "bohinj"
                ]
              }
            }
          ]
        }
      ]
    },
