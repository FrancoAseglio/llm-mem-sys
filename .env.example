# Copy to .env and fill in. Only DATABASE_URL is required.
DATABASE_URL=postgresql://<user>@localhost:5432/memory_db
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Optional switches (all on by default; set to 0 for an ablation). See docs/architecture/04_models.md.
# SUMMARIES=1
# CONSOLIDATE=1
# PAST_FACTS=1
# ABOUT_USER=1
# CHANGE_RULE=1
# NOTE_TAGS=1
# NOTE_FACT_WINDOW=1
# HYBRID_MARKERS=1
# HYBRID_TIMELINE=1
# SAFETY_BYPASS=1
# ROUTING_TOP_N=2
# FULL_NUM_CTX=8192
